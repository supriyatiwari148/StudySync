<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.studysync.controller.AttendanceController"
      spacing="15"
      styleClass="page-container"
      stylesheets="@../css/style.css">

    <Label text="📊 Attendance"
           styleClass="page-title"/>

    <Label text="Track your subject-wise attendance"
           styleClass="page-subtitle"/>

    <Button text="← Back to Dashboard"
            onAction="#backToDashboard"
            styleClass="back-button"/>

    <ScrollPane fitToWidth="true"
                fitToHeight="true"
                hbarPolicy="AS_NEEDED"
                vbarPolicy="NEVER"
                styleClass="scroll-pane">

        <content>

            <HBox fx:id="attendanceContainer"
                  spacing="25"
                  alignment="CENTER"
                  style="-fx-padding: 25;"/>

        </content>

    </ScrollPane>

</VBox>